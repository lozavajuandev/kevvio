POSTGRES_DB=raiz
POSTGRES_USER=raiz
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_PORT=55432
DATABASE_URL=postgresql://raiz:replace-with-a-random-password@127.0.0.1:55432/raiz
UPLOAD_DIR=.data/uploads
# Optional canonical origin when deployed, e.g. https://app.example.com
PUBLIC_APP_URL=
# Server-only. Never use a NEXT_PUBLIC_ prefix for this key.
OPENAI_API_KEY=
OPENAI_DESCRIPTION_MODEL=gpt-5.4-mini

# Studio video service (server-only). No generations occur without this key.
KIE_API_KEY=
RAIZ_PLAN=studio
VIDEO_DAILY_BUDGET_USD=5
# FFmpeg must exist on PATH, or specify its absolute executable path.
FFMPEG_PATH=ffmpeg
