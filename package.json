{
  "name": "raiz-activos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3045",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3045",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:backup": "node --env-file=.env scripts/backup.mjs",
    "test": "node --env-file=.env --test tests/integration.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "next": "16.4.5",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
